{
  "name": "arvouz-docdiff",
  "displayName": "DocDiff — Word Viewer & Git Diffs",
  "description": "Read .docx files inside VS Code and get real, line-level diffs of Word documents in git, Git Graph, GitLens and pull requests.",
  "version": "0.1.0",
  "publisher": "arvouz",
  "author": {
    "name": "Richmond Bautista",
    "url": "https://rbautista.pro"
  },
  "license": "MIT",
  "pricing": "Free",
  "icon": "images/icon.png",
  "homepage": "https://github.com/rchmndbtst/arvouz-docdiff#readme",
  "bugs": {
    "url": "https://github.com/rchmndbtst/arvouz-docdiff/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rchmndbtst/arvouz-docdiff.git"
  },
  "galleryBanner": {
    "color": "#1e2a3a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "docx",
    "word",
    "git",
    "diff",
    "git graph",
    "gitlens",
    "textconv",
    "viewer"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "docdiff.viewer",
        "displayName": "DocDiff Word Viewer",
        "selector": [
          {
            "filenamePattern": "*.{docx,docm,dotx,dotm}"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "docdiff.open",
        "title": "Open in DocDiff Viewer",
        "category": "DocDiff",
        "icon": "$(preview)"
      },
      {
        "command": "docdiff.diffWithHead",
        "title": "Diff with Last Commit",
        "category": "DocDiff",
        "icon": "$(git-compare)"
      },
      {
        "command": "docdiff.setupGitTextDiff",
        "title": "Set Up Git Text Diffs for This Repository",
        "category": "DocDiff",
        "icon": "$(terminal)"
      },
      {
        "command": "docdiff.writeCompanion",
        "title": "Write Markdown Companion",
        "category": "DocDiff",
        "icon": "$(markdown)"
      },
      {
        "command": "docdiff.writeCompanions",
        "title": "Write Markdown Companions for Whole Workspace",
        "category": "DocDiff"
      },
      {
        "command": "docdiff.switchView",
        "title": "Switch Page / Reading View",
        "category": "DocDiff",
        "icon": "$(book)",
        "enablement": "activeCustomEditorId == docdiff.viewer"
      },
      {
        "command": "docdiff.cyclePaperTone",
        "title": "Cycle Paper Tone",
        "category": "DocDiff",
        "icon": "$(color-mode)",
        "enablement": "activeCustomEditorId == docdiff.viewer"
      },
      {
        "command": "docdiff.zoomIn",
        "title": "Zoom In",
        "category": "DocDiff",
        "icon": "$(zoom-in)",
        "enablement": "activeCustomEditorId == docdiff.viewer"
      },
      {
        "command": "docdiff.zoomOut",
        "title": "Zoom Out",
        "category": "DocDiff",
        "icon": "$(zoom-out)",
        "enablement": "activeCustomEditorId == docdiff.viewer"
      },
      {
        "command": "docdiff.zoomReset",
        "title": "Actual Size (100%)",
        "category": "DocDiff",
        "enablement": "activeCustomEditorId == docdiff.viewer"
      },
      {
        "command": "docdiff.showOutput",
        "title": "Show Output",
        "category": "DocDiff",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "docdiff.switchView",
          "when": "activeCustomEditorId == docdiff.viewer"
        },
        {
          "command": "docdiff.cyclePaperTone",
          "when": "activeCustomEditorId == docdiff.viewer"
        },
        {
          "command": "docdiff.zoomIn",
          "when": "activeCustomEditorId == docdiff.viewer"
        },
        {
          "command": "docdiff.zoomOut",
          "when": "activeCustomEditorId == docdiff.viewer"
        },
        {
          "command": "docdiff.zoomReset",
          "when": "activeCustomEditorId == docdiff.viewer"
        }
      ],
      "explorer/context": [
        {
          "command": "docdiff.open",
          "when": "resourceExtname =~ /^\\.(docx|docm|dotx|dotm)$/i",
          "group": "navigation@20"
        },
        {
          "command": "docdiff.diffWithHead",
          "when": "resourceExtname =~ /^\\.(docx|docm|dotx|dotm)$/i",
          "group": "7_docdiff@1"
        },
        {
          "command": "docdiff.writeCompanion",
          "when": "resourceExtname =~ /^\\.(docx|docm|dotx|dotm)$/i",
          "group": "7_docdiff@2"
        }
      ],
      "editor/title": [
        {
          "command": "docdiff.diffWithHead",
          "when": "activeCustomEditorId == docdiff.viewer",
          "group": "navigation@1"
        },
        {
          "command": "docdiff.switchView",
          "when": "activeCustomEditorId == docdiff.viewer",
          "group": "navigation@2"
        },
        {
          "command": "docdiff.writeCompanion",
          "when": "activeCustomEditorId == docdiff.viewer",
          "group": "1_docdiff@1"
        },
        {
          "command": "docdiff.cyclePaperTone",
          "when": "activeCustomEditorId == docdiff.viewer",
          "group": "1_docdiff@2"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "docdiff.diffWithHead",
          "group": "navigation@1"
        },
        {
          "command": "docdiff.writeCompanion",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "docdiff.zoomIn",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "activeCustomEditorId == docdiff.viewer"
      },
      {
        "command": "docdiff.zoomOut",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "activeCustomEditorId == docdiff.viewer"
      },
      {
        "command": "docdiff.zoomReset",
        "key": "ctrl+0",
        "mac": "cmd+0",
        "when": "activeCustomEditorId == docdiff.viewer"
      },
      {
        "command": "docdiff.switchView",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "activeCustomEditorId == docdiff.viewer"
      }
    ],
    "configuration": {
      "title": "DocDiff",
      "properties": {
        "docdiff.defaultView": {
          "type": "string",
          "default": "page",
          "enum": [
            "page",
            "reading"
          ],
          "enumDescriptions": [
            "The Word page layout.",
            "A clean, semantic reading view that follows your editor theme."
          ],
          "description": "View a document opens in."
        },
        "docdiff.defaultZoom": {
          "type": "number",
          "default": 100,
          "minimum": 25,
          "maximum": 400,
          "description": "Zoom level, in percent, a document opens at."
        },
        "docdiff.defaultPaperTone": {
          "type": "string",
          "default": "white",
          "enum": [
            "white",
            "sepia",
            "night"
          ],
          "description": "Paper tone behind Page view."
        },
        "docdiff.maxFileSizeMb": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "maximum": 500,
          "description": "Largest document, in MB, DocDiff will open."
        },
        "docdiff.reloadOnChange": {
          "type": "boolean",
          "default": true,
          "description": "Re-render an open document when its file changes on disk."
        },
        "docdiff.autoUpdateCompanions": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Rewrite a document's `.docx.md` Markdown companion whenever the document changes. Only companions that already exist are updated; DocDiff never creates one unless you run **DocDiff: Write Markdown Companion**."
        }
      }
    }
  },
  "scripts": {
    "build": "node ./esbuild.mjs",
    "watch": "node ./esbuild.mjs --watch",
    "check-types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "lint": "eslint src webview-src test",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\"",
    "verify": "npm run lint && npm run check-types && npm run test",
    "vscode:prepublish": "npm run verify && npm run build",
    "package": "npm run build && vsce package --no-dependencies",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.44",
    "docx-preview": "^0.3.7",
    "dompurify": "^3.3.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.19.25",
    "@types/vscode": "1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.1",
    "patch-package": "^8.0.1",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
